# ─── PosBank · variables de entorno ───────────────────────────────
# Copia este archivo a .env y completa los valores.

# App
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
LOG_LEVEL=info

# Supabase (https://app.supabase.com → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon key: cliente público (respeta RLS). Úsala para requests con JWT de usuario.
SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role key: SECRETA. Bypasea RLS. Solo backend (cron, admin). NUNCA al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# JWT (para verificar tokens de Supabase Auth en el backend)
SUPABASE_JWT_SECRET=super-secret-jwt-from-supabase-settings

# WhatsApp — Meta Cloud API (o Twilio). Ver src/integrations/whatsapp
WHATSAPP_PROVIDER=meta            # meta | twilio
WHATSAPP_VERIFY_TOKEN=posbank-verify-token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Twilio (si WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Alexa Skills Kit
ALEXA_SKILL_ID=

# Make.com — secret compartido para firmar webhooks salientes
MAKE_WEBHOOK_SECRET=

# Cifrado de credenciales de integraciones contables (Alegra, Siigo, etc.)
# Genera una clave aleatoria de 32 bytes o más (ej. openssl rand -hex 32)
ACCOUNTING_ENCRYPTION_KEY=

# Claude (Anthropic) — lectura inteligente de facturas por foto
ANTHROPIC_API_KEY=

# Administradores de la plataforma (acceso global a métricas). Separados por coma
PLATFORM_ADMIN_EMAILS=admin@ingizer.com
